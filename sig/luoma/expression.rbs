module Luoma
  type t_path_segment = Name | StringLiteral | IndexSelector | Variable | Predicate

  interface _Traversable
    def children: () -> Array[_Traversable]
    def to_s: () -> String
    def class: () -> untyped
  end

  class Expression
    @token: t_token

    @span: t_token

    attr_reader token: t_token

    attr_reader span: t_token

    #  (t_token) -> void
    def initialize: (t_token token) -> void

    #  (RenderContext) -> untyped
    def evaluate: (RenderContext context) -> untyped

    #  () -> Array[_Traversable]
    def children: () -> Array[_Traversable]
                
    #  () -> Array[Name]
    def scope: () -> Array[Name]
                
    def to_s: () -> String
  end

  class GroupExpression < Expression
    @expr: Expression

    @segments: Array[t_path_segment]

    #  (t_token, Expression, Array[t_path_segment]) -> void
    def initialize: (t_token token, Expression expr, Array[t_path_segment] segments) -> void

    #  (t_token) -> self
    def with: (t_token token) -> self
            
    #  (Array[t_path_segment]) -> String
    def path: (Array[t_path_segment]) -> String
  end

  class TernaryExpression < Expression
    @consequence: Expression

    @condition: Expression

    @alternative: Expression?

    #  (t_token, Expression, Expression, Expression?) -> void
    def initialize: (t_token token, Expression consequence, Expression condition, Expression? alternative) -> void
  end

  class FilteredExpression < Expression
    @left: Expression

    @filter: Filter

    @name: String?

    @span: t_token

    def initialize: (t_token token, Expression left, Filter filter) -> void
                  
    def evaluate_lambda: (LambdaExpr expr, RenderContext context) -> untyped
                       
    def evaluate_filter: (String name, RenderContext context) -> untyped
  end

  class PrefixExpression < Expression
    @right: Expression

    #  (t_token, Expression) -> void
    def initialize: (t_token token, Expression right) -> void
  end

  class NotExpression < PrefixExpression
  end

  class PosExpression < PrefixExpression
  end

  class NegExpression < PrefixExpression
  end

  class InfixExpression < Expression
    @left: untyped

    @right: untyped

    @span: untyped

    #  (t_token, Expression, Expression) -> void
    def initialize: (t_token token, Expression left, Expression right) -> void
  end

  class CoalesceExpression < InfixExpression
  end

  class OrExpression < InfixExpression
  end

  class AndExpression < InfixExpression
  end

  class EqExpression < InfixExpression
  end

  class NeExpression < InfixExpression
  end

  class LtExpression < InfixExpression
  end

  class LeExpression < InfixExpression
  end

  class GtExpression < InfixExpression
  end

  class GeExpression < InfixExpression
  end

  class ContainsExpression < InfixExpression
  end

  class InExpression < InfixExpression
  end

  class AddExpression < InfixExpression
  end

  class SubExpression < InfixExpression
  end

  class MulExpression < InfixExpression
  end

  class DivExpression < InfixExpression
  end

  class ModExpression < InfixExpression
  end

  class Variable < Expression
    @root: Name | StringLiteral | Variable

    @segments: Array[t_path_segment]

    @span: t_token

    attr_reader root: Name | StringLiteral | Variable

    attr_reader segments: Array[t_path_segment]

    #  (t_token, Name | StringLiteral | Variable, Array[PathSegment])
    def initialize: (t_token token, Name | StringLiteral | Variable, Array[t_path_segment]) -> void

    #  (RenderContext) -> untyped
    def evaluate: (RenderContext context) -> untyped

    #  () -> String
    def to_s: () -> String
            
    
    def ident?: (String name) -> bool

    private

    #  (Array[PathSegment]) -> String
    def path: (Array[t_path_segment] segments) -> String
  end

  class IndexSelector < Expression
    @value: Integer

    attr_reader value: Integer

    #  (t_token, Integer)
    def initialize: (t_token token, Integer value) -> void

    #  (RenderContext) -> untyped
    def evaluate: (RenderContext context) -> untyped

    #  () -> Array[_Traversable]
    def children: () -> ::Array[Luoma::_Traversable]

    #  () -> String
    def to_s: () -> String

    def with: (t_token token) -> self
  end

  class Lambda < Expression
    @params: Array[Name]

    @expr: Expression

    #  (t_token, Array[Name], Expression) -> void
    def initialize: (t_token token, Array[Name] params, Expression expr) -> void
  end

  class StringLiteral < Expression
    @segments: Array[String|Expression]

    attr_reader segments: Array[String|Expression]

    #  (t_token, Array[String|Expression], t_token)
    def initialize: (t_token token, Array[String|Expression] segments, t_token end_token) -> void

    def with: (t_token token) -> self
            
    #  () -> String?
    def value: () -> String?
  end

  class IntegerLiteral < Expression
    @value: Integer

    attr_reader value: Integer

    #  (t_token, Integer)
    def initialize: (t_token token, Integer value) -> void

    #  (RenderContext) -> untyped
    def evaluate: (RenderContext context) -> untyped

    #  () -> Array[_Traversable]
    def children: () -> ::Array[_Traversable]

    #  () -> String
    def to_s: () -> String
  end

  class FloatLiteral < Expression
    @value: Float

    attr_reader value: Float

    #  (t_token, Float)
    def initialize: (t_token token, Float value) -> void

    #  (RenderContext) -> untyped
    def evaluate: (RenderContext context) -> untyped

    #  () -> Array[_Traversable]
    def children: () -> ::Array[_Traversable]

    #  () -> String
    def to_s: () -> String
  end

  class BooleanLiteral < Expression
    @value: bool

    attr_reader value: bool

    #  (t_token, bool)
    def initialize: (t_token token, bool value) -> void

    #  (RenderContext) -> untyped
    def evaluate: (RenderContext context) -> untyped

    #  () -> Array[_Traversable]
    def children: () -> ::Array[_Traversable]

    #  () -> String
    def to_s: () -> String
  end

  class NullLiteral < Expression
    #  (RenderContext) -> untyped
    def evaluate: (RenderContext context) -> untyped

    #  () -> Array[_Traversable]
    def children: () -> ::Array[_Traversable]

    #  () -> String
    def to_s: () -> String
  end

  class RangeLiteral < Expression
    @start: Expression

    @stop: Expression

    #  (t_token, Expression, Expression) -> void
    def initialize: (t_token token, Expression start, Expression stop) -> void

    #  (RenderContext) -> untyped
    def evaluate: (RenderContext context) -> untyped

    #  () -> Array[_Traversable]
    def children: () -> ::Array[_Traversable]

    #  () -> String
    def to_s: () -> ::String
  end

  class ArrayLiteral < Expression
    @items: Array[Expression|Spread]

    def initialize: (t_token token, Array[Expression|Spread] items) -> void

    def with: (t_token token) -> self
  end

  class ObjectLiteral < Expression
    @items: Array[Item|Spread]

    #   (t_token token, Array[Item|Spread] items) -> void
    def initialize: (t_token token, Array[Item|Spread] items) -> void

    def with: (untyped token) -> self
  end

  class Predicate < Expression
    @value: String

    attr_reader value: String

    #   (t_token, String) -> void
    def initialize: (t_token token, String value) -> void
  end

  class Spread
    @token: t_token

    @expr: Expression

    attr_reader token: t_token

    attr_reader expr: Expression

    def initialize: (t_token token, Expression expr) -> void

    #  () -> Array[_Traversable]
    def children: () -> ::Array[_Traversable]

    #  () -> String
    def to_s: () -> ::String
  end

  class Item
    @token: t_token

    @key: Name

    @expr: Expression

    attr_reader token: t_token

    attr_reader key: Name

    attr_reader expr: Expression

    #  (t_token, Name, Expression) -> void
    def initialize: (t_token token, Name key, Expression expr) -> void

    #  () -> Array[_Traversable]
    def children: () -> ::Array[_Traversable]

    #  () -> String
    def to_s: () -> ::String
  end

  class Name
    @token: t_token

    @value: String

    @span: t_token

    attr_reader token: t_token

    attr_reader span: t_token

    attr_reader value: String

    #  (t_token, String) -> void
    def initialize: (t_token token, String value) -> void

    #  (RenderContext) -> untyped
    def evaluate: (RenderContext context) -> untyped
                
    #  () -> Array[_Traversable]
    def children: () -> ::Array[Luoma::_Traversable]

    #  () -> String
    def to_s: () -> String
  end

  class Filter
    @token: t_token

    @name: Variable

    @args: Array[Expression]

    @kwargs: Array[KeywordArgument]

    @span: t_token

    attr_reader token: t_token

    attr_reader span: t_token

    attr_reader name: Variable

    attr_reader kwargs: Array[KeywordArgument]

    attr_reader args: Array[Expression]

    #  (t_token, Name, Array[Expression | KeywordArgument])
    def initialize: (t_token token, Variable name, Array[Expression] args, Array[KeywordArgument] kwargs) -> void

    def children: () -> Array[Luoma::_Traversable]

    def to_s: () -> (::String)
  end

  class KeywordArgument
    @token: t_token

    @name: Name

    @expression: Expression

    @span: t_token

    attr_reader token: t_token

    attr_reader span: t_token

    attr_reader name: Name

    attr_reader expression: Expression

    #  (t_token, Name, Expression) -> void
    def initialize: (t_token token, Name name, Expression expression) -> void
                  
    #  () -> Array[_Traversable]
    def children: () -> ::Array[_Traversable]

    #  () -> String
    def to_s: () -> ::String
            
    def deconstruct: () -> ::Array[untyped]

    def deconstruct_keys: (untyped keys) -> { name: untyped, expression: untyped }
  end

  class PredicateFunction
    @name: String

    @func: untyped

    attr_reader name: String

    attr_reader func: untyped

    #  (String, untyped) -> void
    def initialize: (String name, untyped func) -> void

    #  (RenderContext, untyped) -> bool
    def call: (RenderContext context, untyped obj) -> bool
  end

  class LambdaExpr
    @params: Array[String]

    @expr: Expression

    @context: RenderContext

    attr_reader params: Array[String]

    #  (Array[String], Expression, RenderContext) -> void
    def initialize: (Array[String] params, Expression expr, RenderContext context) -> void

    #  (Array[Untyped]) -> untyped
    def call: (Array[untyped] args) -> untyped

    #  (Enumerable[untyped]) -> Array[untyped]
    def broadcast_with_index: (Enumerable[untyped] enum) -> Array[untyped]

    #  (untyped, Integer) -> untyped
    def call_with_index: (untyped value, Integer index) -> untyped
  end

  #  (Expression) -> String
  def self.tree_view: (Expression) -> String
end