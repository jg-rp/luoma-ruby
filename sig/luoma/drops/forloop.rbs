module Luoma
  class ForLoopDrop < Drop
    @length: Integer

    @parent: ForLoopDrop?

    @index: Integer

    attr_reader length: Integer

    attr_reader parentloop: ForLoopDrop?

    KEYS: Set[String]

    #  (Integer, ForLoopDrop?) -> void
    def initialize: (Integer length, ForLoopDrop? parent) -> void

    def key?: (String key, RenderContext context) -> untyped

    def fetch: (untyped key, Luoma::RenderContext context, ?default: untyped?) -> untyped

    def next: () -> untyped

    def index: () -> untyped

    def index0: () -> untyped

    def rindex: () -> untyped

    def rindex0: () -> untyped

    def first: () -> untyped

    def last: () -> untyped

  end
end