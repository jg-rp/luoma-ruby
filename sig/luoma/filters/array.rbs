module Luoma
  module Filters
    # Return the concatenation of items in _left_ separated by _sep_.
    # Coerce items in _left_ to strings if they aren't strings already.
    def self.join: (FilterContext context, untyped left, ?::String sep) -> untyped

    # If _left_ is enumerable, return _left_ flattened to _depth_. Otherwise
    # return _left_.
    def self.flatten: (FilterContext context, untyped left, ?untyped? depth) -> untyped
                    
    # Return _true_ if at least one item in _left_ is truthy.
    def self.any: (FilterContext context, untyped left, ?untyped key, ?untyped value) -> untyped
                
    # Return true if all items in _left_ are truthy.
    def self.all: (FilterContext context, untyped left, ?untyped key, ?untyped value) -> untyped

    # Return a copy of _left_ with nil items removed.
    # Coerce _left_ to an array-like object if it is not one already.
    #
    # If _key_ is given, assume items in _left_ are hash-like and remove items from _left_
    # where `item.fetch(key, nil)` is nil.
    #
    # If key is not `:nothing`, coerce it to a string before calling `fetch` on items in
    # _left_.
    def self.compact: (FilterContext context, untyped left, ?untyped key) -> untyped

    # Return _left_ concatenated with _right_, or nil if _right_ is not an array.
    # Coerce _left_ to an array if it isn't an array already.
    def self.concat: (FilterContext context, untyped left, untyped right) -> untyped

    def self.find: (FilterContext context, untyped left, untyped key, ?untyped? value) -> (untyped | nil)

    def self.find_index: (FilterContext context, untyped left, untyped key, ?untyped? value) -> (untyped | nil)

    def self.has: (FilterContext context, untyped left, untyped key, ?untyped? value) -> (true | false)

    # Return the first item in _left_, or `nil` if _left_ does not have a first item.
    def self.first: (FilterContext context, untyped left) -> untyped

    # Return the last item in _left_, or `nil` if _left_ does not have a last item.
    def self.last: (FilterContext context, untyped left) -> untyped

    def self.map: (FilterContext context, untyped left, untyped key) -> untyped

    # Return _left_ with all items in reverse order.
    # Coerce _left_ to an array if it isn't an array already.
    def self.reverse: (FilterContext context, untyped left) -> untyped

    def self.reject: (FilterContext context, untyped left, untyped key, ?untyped? value) -> untyped

    def self.where: (FilterContext context, untyped left, untyped key, ?untyped? value) -> untyped

    # Deduplicate items in _left_.
    # Coerce _left_ to an array if it isn't an array already.
    def self.uniq: (FilterContext context, untyped left, ?untyped? key) -> untyped
                 
    # Return the sum of all numeric values in the input array.
    def self.sum: (FilterContext context, untyped left, ?untyped? key) -> untyped

    # Combine _left_ with _right_, producing an array or pairs.
    # Coerce _left_ and _right_ to arrays if they aren't arrays already.
    def self.zip: (FilterContext context, untyped left, untyped right) -> untyped
  end
end