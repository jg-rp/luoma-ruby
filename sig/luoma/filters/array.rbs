module Luoma
  module Filters
    # Return the concatenation of items in _left_ separated by _sep_.
    # Coerce items in _left_ to strings if they aren't strings already.
    def self.join: (untyped left, ?::String sep, context: FilterContext) -> untyped

    # Return a copy of _left_ with nil items removed.
    # Coerce _left_ to an array-like object if it is not one already.
    #
    # If _key_ is given, assume items in _left_ are hash-like and remove items from _left_
    # where `item.fetch(key, nil)` is nil.
    #
    # If key is not `:nothing`, coerce it to a string before calling `fetch` on items in
    # _left_.
    def self.compact: (untyped left, ?::Symbol key, context: FilterContext) -> untyped

    # Return _left_ concatenated with _right_, or nil if _right_ is not an array.
    # Coerce _left_ to an array if it isn't an array already.
    def self.concat: (untyped left, untyped right, context: FilterContext) -> untyped

    def self.find: (untyped left, untyped key, ?untyped? value, context: FilterContext) -> (untyped | nil)

    def self.find_index: (untyped left, untyped key, ?untyped? value, context: FilterContext) -> (untyped | nil)

    def self.has: (untyped left, untyped key, ?untyped? value, context: FilterContext) -> (true | false)

    # Return the first item in _left_, or `nil` if _left_ does not have a first item.
    def self.first: (untyped left) -> untyped

    # Return the last item in _left_, or `nil` if _left_ does not have a last item.
    def self.last: (untyped left) -> untyped

    def self.map: (untyped left, untyped key, context: FilterContext) -> untyped

    # Return _left_ with all items in reverse order.
    # Coerce _left_ to an array if it isn't an array already.
    def self.reverse: (untyped left, context: FilterContext) -> untyped

    def self.reject: (untyped left, untyped key, ?untyped? value, context: FilterContext) -> untyped

    def self.where: (untyped left, untyped key, ?untyped? value, context: FilterContext) -> untyped

    # Deduplicate items in _left_.
    # Coerce _left_ to an array if it isn't an array already.
    def self.uniq: (untyped left, ?untyped? key, context: FilterContext) -> untyped
  end
end