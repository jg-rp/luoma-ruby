{
  "tests": [
    {
      "name": "array of ints",
      "template": "{{ [1, 10, 9] | max }}",
      "result": "10"
    },
    {
      "name": "array of numeric strings",
      "template": "{{ ['1', '10', '-9'] | max }}",
      "result": "10"
    },
    {
      "name": "mixed array of strings",
      "template": "{{ ['1', 'foo', '10', '-9'] | max }}",
      "result": "10"
    },
    {
      "name": "array of objects, string key",
      "template": "{{ [{'a': 100}, {'a': -100}] | max: 'a' }}",
      "result": "{\"a\":100}"
    },
    {
      "name": "array of objects, lambda key",
      "template": "{{ [{'a': 100}, {'a': -100}] | max: o -> o.a }}",
      "result": "{\"a\":100}"
    }
  ]
}
