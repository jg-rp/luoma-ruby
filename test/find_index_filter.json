{
  "tests": [
    {
      "name": "array of strings",
      "template": "{{ a | find_index: 'z' }}",
      "data": {
        "a": ["x", "y", "z"]
      },
      "result": "2"
    },
    {
      "name": "array of strings, substring match",
      "template": "{{ a | find_index: 'oo' }}",
      "data": {
        "a": ["x", "y", "zoo"]
      },
      "result": ""
    },
    {
      "name": "array of strings, no match",
      "template": "{{ a | find_index: 'foo' }}",
      "data": {
        "a": ["x", "y", "zoo"]
      },
      "result": ""
    },
    {
      "name": "mixed array, default value",
      "template": "{{ a | find_index: 'z' }}",
      "data": {
        "a": ["x", null, "z", false, true]
      },
      "result": "2"
    },
    {
      "name": "string input, character match",
      "template": "{{ a | find_index: 'z' }}",
      "data": {
        "a": "zoo"
      },
      "result": "0"
    },
    {
      "name": "string input, string value, match",
      "template": "{{ a | find_index: 'z', 'z' }}",
      "data": {
        "a": "zoo"
      },
      "result": "0"
    },
    {
      "name": "string input, string value, no match",
      "template": "{{ a | find_index: 'z', 'y' }}",
      "data": {
        "a": "zoo"
      },
      "result": ""
    },
    {
      "name": "object input, default value, match",
      "template": "{{ a | find_index: 'z' }}",
      "data": {
        "a": {
          "z": 42
        }
      },
      "result": ""
    },
    {
      "name": "object input, default value, no match",
      "template": "{{ a | find_index: 'foo' }}",
      "data": {
        "a": {
          "z": 42
        }
      },
      "result": ""
    },
    {
      "name": "object input, int value, match",
      "template": "{{ a | find_index: 'z', 42 }}",
      "data": {
        "a": {
          "z": 42
        }
      },
      "result": ""
    },
    {
      "name": "object input, explicit nil, match",
      "template": "{{ a | find_index: 'z', nil }}",
      "data": {
        "a": {
          "z": null
        }
      },
      "result": ""
    },
    {
      "name": "array of objects, explicit nil, match",
      "template": "{{ a | find_index: 'z', nil }}",
      "data": {
        "a": [
          "foo",
          "bar",
          {
            "z": null
          }
        ]
      },
      "result": "2"
    },
    {
      "name": "array of objects, int value, match",
      "template": "{{ a | find_index: 'z', 42 }}",
      "data": {
        "a": [
          {
            "x": 99
          },
          {
            "z": 42,
            "foo": "bar"
          }
        ]
      },
      "result": "1"
    },
    {
      "name": "array of objects, with a nil",
      "template": "{% assign b = a | find_index: 'z', 42 %}{{ a[b].foo }}",
      "data": {
        "a": [
          {
            "x": 99
          },
          null,
          {
            "z": 42,
            "foo": "bar"
          }
        ]
      },
      "result": "bar"
    },
    {
      "name": "array of objects, lambda",
      "template": "{{ a | find_index: obj => (obj.z == 42) }}",
      "data": {
        "a": [
          {
            "x": 99
          },
          {
            "z": 42,
            "foo": "bar"
          }
        ]
      },
      "result": "1"
    }
  ]
}
