{
  "tests": [
    {
      "name": "array literals",
      "template": "{{ ['a', 'b', 'c'] | zip: [1, 2, 3] }}",
      "result": "[[\"a\",1],[\"b\",2],[\"c\",3]]"
    },
    {
      "name": "object literals",
      "template": "{{ {'a':1, 'b':2} | zip: {'c':3, 'd':4} }}",
      "result": "[[[\"a\",1],[\"c\",3]],[[\"b\",2],[\"d\",4]]]"
    },
    {
      "name": "array literals, left is longer",
      "template": "{{ ['a', 'b', 'c'] | zip: [1, 2] }}",
      "result": "[[\"a\",1],[\"b\",2],[\"c\",null]]"
    },
    {
      "name": "array literals, left is shorter",
      "template": "{{ ['a', 'b'] | zip: [1, 2, 3] }}",
      "result": "[[\"a\",1],[\"b\",2]]"
    }
  ]
}
