{
  "tests": [
    {
      "name": "range",
      "template": "{{ (1..3) | concat: foo | join: '#' }}",
      "data": {
        "foo": [5, 6, 7]
      },
      "result": "1#2#3#5#6#7"
    },
    {
      "name": "arrays of strings",
      "template": "{{ a | concat: b | join: '#' }}",
      "data": {
        "a": ["a", "b"],
        "b": ["c", "d"]
      },
      "result": "a#b#c#d"
    },
    {
      "name": "missing argument is an error",
      "template": "{{ a | concat | join: '#' }}",
      "data": {
        "a": ["a", "b"]
      },
      "invalid": true,
      "tags": ["strict filters"]
    },
    {
      "name": "non array-like argument",
      "template": "{{ a | concat: b | join: '#' }}",
      "data": {
        "a": ["a", "b"],
        "b": 5
      },
      "result": "a#b#5"
    },
    {
      "name": "string",
      "template": "{{ a | concat: b | join: '#' }}",
      "data": {
        "a": "ab",
        "b": ["c", "d"]
      },
      "result": "a#b#c#d"
    },
    {
      "name": "array contains non string",
      "template": "{{ a | concat: b | join: '#' }}",
      "data": {
        "a": ["a", "b", 5],
        "b": ["c", "d"]
      },
      "result": "a#b#5#c#d"
    },
    {
      "name": "undefined",
      "template": "{{ nosuchthing | concat: b | join: '#' }}",
      "data": {
        "b": ["c", "d"]
      },
      "result": "c#d"
    },
    {
      "name": "undefined argument is an error",
      "template": "{{ a | concat: nosuchthing | join: '#' }}",
      "data": {
        "a": ["a", "b"]
      },
      "result": "a#b"
    },
    {
      "name": "nested array",
      "template": "{{ a | concat: b | join: '#' }}",
      "data": {
        "a": [
          ["a", "x"],
          ["b", ["y", ["z"]]]
        ],
        "b": ["c", "d"]
      },
      "result": "[\"a\",\"x\"]#[\"b\",[\"y\",[\"z\"]]]#c#d"
    }
  ]
}
