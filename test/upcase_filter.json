{
  "tests": [
    {
      "name": "make lower case",
      "template": "{{ \"hello\" | upcase }}",
      "result": "HELLO"
    },
    {
      "name": "not a string",
      "template": "{{ 5 | upcase }}",
      "result": "5"
    },
    {
      "name": "unexpected argument",
      "template": "{{ \"hello\" | upcase: 5 }}",
      "invalid": true,
      "tags": ["strict filters"]
    },
    {
      "name": "undefined left value",
      "template": "{{ nosuchthing | upcase }}",
      "result": ""
    }
  ]
}
