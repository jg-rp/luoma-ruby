{
  "tests": [
    {
      "name": "empty array",
      "template": "{{ a | sort_numeric }}",
      "data": {
        "a": []
      },
      "result": "[]"
    },
    {
      "name": "empty array with key",
      "template": "{{ a | sort_numeric: 'x' }}",
      "data": {
        "a": []
      },
      "result": "[]"
    },
    {
      "name": "array of numeric strings",
      "template": "{{ a | sort_numeric }}",
      "data": {
        "a": ["10", "3", "2", "1"]
      },
      "result": "[\"1\",\"2\",\"3\",\"10\"]"
    },
    {
      "name": "array of integers",
      "template": "{{ a | sort_numeric }}",
      "data": {
        "a": [10, 3, 2, 1]
      },
      "result": "[1,2,3,10]"
    },
    {
      "name": "array of floats",
      "template": "{{ a | sort_numeric }}",
      "data": {
        "a": [10.1, 3.5, 2.3, 1.1, 1.01]
      },
      "result": "[1.01,1.1,2.3,3.5,10.1]"
    },
    {
      "name": "array of string floats",
      "template": "{{ a | sort_numeric }}",
      "data": {
        "a": ["10.1", "3.5", "2.3", "1.1", "1.01"]
      },
      "result": "[\"1.01\",\"1.1\",\"2.3\",\"3.5\",\"10.1\"]"
    },
    {
      "name": "array of negative numeric strings",
      "template": "{{ a | sort_numeric }}",
      "data": {
        "a": ["1", "-1"]
      },
      "result": "[\"-1\",\"1\"]"
    },
    {
      "name": "null",
      "template": "{{ a | sort_numeric }}",
      "data": {
        "a": null
      },
      "result": "[null]"
    },
    {
      "name": "array of objects",
      "template": "{{ a | sort_numeric }}",
      "data": {
        "a": [
          { "y": "-1", "x": "10" },
          { "x": "3" },
          { "x": "2" },
          { "x": "1" }
        ]
      },
      "result": "[{\"y\":\"-1\",\"x\":\"10\"},{\"x\":\"1\"},{\"x\":\"2\"},{\"x\":\"3\"}]"
    },
    {
      "name": "array of objects with key",
      "template": "{{ a | sort_numeric: 'x' }}",
      "data": {
        "a": [
          { "y": "-1", "x": "10" },
          { "x": "3" },
          { "x": "2" },
          { "x": "1" }
        ]
      },
      "result": "[{\"x\":\"1\"},{\"x\":\"2\"},{\"x\":\"3\"},{\"y\":\"-1\",\"x\":\"10\"}]"
    },
    {
      "name": "array of objects with missing key",
      "template": "{{ a | sort_numeric: 'x' }}",
      "data": {
        "a": [
          { "y": "-1", "x": "10" },
          { "x": "3" },
          { "x": "2" },
          { "y": "1" }
        ]
      },
      "result": "[{\"x\":\"2\"},{\"x\":\"3\"},{\"y\":\"-1\",\"x\":\"10\"},{\"y\":\"1\"}]"
    },
    {
      "name": "string",
      "template": "{{ a | sort_numeric }}",
      "data": {
        "a": "54321"
      },
      "result": "[\"1\",\"2\",\"3\",\"4\",\"5\"]"
    },
    {
      "name": "version numbers",
      "template": "{{ a | sort_numeric }}",
      "data": {
        "a": ["v1.2", "v1.9", "v10.0", "v1.10", "v1.1.0"]
      },
      "result": "[\"v1.1.0\",\"v1.2\",\"v1.9\",\"v1.10\",\"v10.0\"]"
    },
    {
      "name": "leading zeros",
      "template": "{{ a | sort_numeric }}",
      "data": {
        "a": ["107", "042", "0001", "02", "17"]
      },
      "result": "[\"0001\",\"02\",\"17\",\"042\",\"107\"]"
    },
    {
      "name": "array of ints with key",
      "template": "{{ a | sort_numeric: 'x' }}",
      "data": {
        "a": [2, 1]
      },
      "result": "[2,1]"
    },
    {
      "name": "array of objects with lambda key",
      "template": "{{ a | sort_numeric: o => o.x }}",
      "data": {
        "a": [
          { "y": "-1", "x": "10" },
          { "x": "3" },
          { "x": "2" },
          { "x": "1" }
        ]
      },
      "result": "[{\"x\":\"1\"},{\"x\":\"2\"},{\"x\":\"3\"},{\"y\":\"-1\",\"x\":\"10\"}]"
    }
  ]
}
