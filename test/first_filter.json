{
  "tests": [
    {
      "name": "range",
      "template": "{{ (1..3) | first }}",
      "result": "1"
    },
    {
      "name": "array of strings",
      "template": "{{ arr | first }}",
      "data": {
        "arr": ["a", "b"]
      },
      "result": "a"
    },
    {
      "name": "array of things",
      "template": "{{ arr | first }}",
      "data": {
        "arr": ["a", "b", 1, [], {}]
      },
      "result": "a"
    },
    {
      "name": "empty array",
      "template": "{{ arr | first }}",
      "data": {
        "arr": []
      },
      "result": ""
    },
    {
      "name": "not an array",
      "template": "{{ arr | first }}",
      "data": {
        "arr": 12
      },
      "result": "12"
    },
    {
      "name": "undefined",
      "template": "{{ nosuchthing | first }}",
      "result": ""
    },
    {
      "name": "first of a string",
      "template": "{{ 'hello' | first }}",
      "result": "h"
    },
    {
      "name": "first of an object",
      "template": "{% assign x = a | first %}({{ x[0] }},{{ x[1] }})",
      "data": {
        "a": {
          "b": 1,
          "c": 2
        }
      },
      "result": "(b,1)"
    }
  ]
}
