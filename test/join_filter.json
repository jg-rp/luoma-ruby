{
  "tests": [
    {
      "name": "range",
      "template": "{{ (1..3) | join: '#' }}",
      "result": "1#2#3"
    },
    {
      "name": "string",
      "template": "{{ 'a,b' | join: '#' }}",
      "result": "a#,#b"
    },
    {
      "name": "int",
      "template": "{{ 123 | join: '#' }}",
      "result": "123"
    },
    {
      "name": "array of strings",
      "template": "{{ arr | join: '#' }}",
      "data": {
        "arr": ["a", "b"]
      },
      "result": "a#b"
    },
    {
      "name": "array of integers",
      "template": "{{ arr | join: '#' }}",
      "data": {
        "arr": [1, 2]
      },
      "result": "1#2"
    },
    {
      "name": "missing argument defaults to a single space",
      "template": "{{ arr | join }}",
      "data": {
        "arr": ["a", "b"]
      },
      "result": "a b"
    },
    {
      "name": "argument is not a string",
      "template": "{{ arr | join: 5 }}",
      "data": {
        "arr": ["a", "b"]
      },
      "result": "a5b"
    },
    {
      "name": "left value contains non string",
      "template": "{{ arr | join: '#' }}",
      "data": {
        "arr": ["a", "b", 1]
      },
      "result": "a#b#1"
    },
    {
      "name": "undefined left value",
      "template": "{{ nosuchthing | join: '#' }}",
      "result": ""
    },
    {
      "name": "undefined argument",
      "template": "{{ arr | join: nosuchthing }}",
      "data": {
        "arr": ["a", "b"]
      },
      "result": "ab"
    },
    {
      "name": "too many arguments",
      "template": "{{ arr | join: '#', 42 }}",
      "data": {
        "arr": ["a", "b"]
      },
      "invalid": true,
      "tags": ["strict"]
    }
  ]
}
