{
  "tests": [
    {
      "name": "range literal",
      "template": "{{ (1..3) | last }}",
      "result": "3"
    },
    {
      "name": "array of strings",
      "template": "{{ arr | last }}",
      "data": {
        "arr": ["a", "b"]
      },
      "result": "b"
    },
    {
      "name": "array of things",
      "template": "{{ arr | last }}",
      "data": {
        "arr": ["a", "b", 1, [], {}]
      },
      "result": "{}"
    },
    {
      "name": "empty array",
      "template": "{{ arr | last }}",
      "data": {
        "arr": []
      },
      "result": ""
    },
    {
      "name": "not an array",
      "template": "{{ arr | last }}",
      "data": {
        "arr": 12
      },
      "result": "12"
    },
    {
      "name": "undefined",
      "template": "{{ nosuchthing | last }}",
      "result": ""
    },
    {
      "name": "last of a string",
      "template": "{{ 'hello' | last }}",
      "result": "o"
    },
    {
      "name": "last of an object",
      "template": "{{ a | last }}",
      "data": {
        "a": {
          "b": 1,
          "c": 2
        }
      },
      "result": "[\"c\",2]"
    }
  ]
}
